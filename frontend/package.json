{
  "name": "teraschool-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "generate": "openapi-typescript ../backend/applications/server/target/openapi.json -o src/shared/generated/api.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "antd": "6.6.8",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "8.3.5",
    "vitest": "3.2.4"
  },
  "type": "module"
}
