# 复制为 deploy/.env 后使用；不要提交真实口令。
# 生成方式（Linux/macOS）：openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
TS_DATABASE_NAME=teraschool
TS_ADMIN_PASSWORD=change-me-admin
TS_MIGRATOR_PASSWORD=change-me-migrator
TS_APP_PASSWORD=change-me-app
TS_IDENTITY_PASSWORD=change-me-identity
TS_SESSION_PASSWORD=change-me-session
TS_AUDIT_PASSWORD=change-me-audit
TS_SCHEDULER_PASSWORD=change-me-scheduler
TS_PLATFORM_PASSWORD=change-me-platform
# 同一台机器跑多个环境时改这个：它决定容器名前缀和卷名前缀，必须各不相同。
TS_PROJECT_NAME=teraschool
# 对外端口；8080 常被其它本机服务占用。多环境时每个环境一个端口。
TS_HTTP_PORT=8088
# 数据库只绑定 127.0.0.1；宿主机迁移与排障用这个端口。多环境时每个环境一个端口。
TS_DB_PORT=55432
# 没有 TLS 时只能是 false；接入 HTTPS 后必须为 true。
TS_COOKIE_SECURE=false
# 对象存储（SeaweedFS，S3 兼容）。附件与品牌图依赖它；桶由 objectstore-init 自动创建。
TS_STORAGE_ACCESS_KEY=change-me-objectstore
TS_STORAGE_SECRET_KEY=change-me-objectstore-secret
TS_STORAGE_BUCKET=teraschool
TS_STORAGE_REGION=us-east-1
# 基础镜像来源。默认走 Docker Hub；无法直连时可指向可用镜像源，
# 例如 public.ecr.aws/docker/library/<image>。构建与运行都只在本机，不推送镜像。
TS_IMAGE_POSTGRES=postgres:18
# PDF 导出用 Playwright 驱动 Chromium，因此运行镜像自带 JDK 25 + Chromium + 中文字体，
# 约 5.4GB。不需要 PDF 时可改成 eclipse-temurin:25-jre（约 300MB），导出会失败。
TS_IMAGE_JAVA_RUNTIME=mcr.microsoft.com/playwright/java:v1.64.0-noble
TS_IMAGE_NGINX=nginx:1.29-alpine
# 与 backend/pom.xml 的 flyway.version 保持同一大版本。
TS_IMAGE_FLYWAY=flyway/flyway:12
# SeaweedFS 固定版本；MinIO 已停止维护，不再使用。
TS_IMAGE_SEAWEEDFS=chrislusf/seaweedfs:latest
